{
  "name": "cert-analyst-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "vitest run src",
    "test:coverage": "vitest run src --coverage --coverage.include=src/numbers.ts --coverage.include=src/contracts.ts --coverage.include=src/review-state.ts --coverage.reporter=text --coverage.reporter=json-summary --coverage.reportsDirectory=test-results/coverage",
    "test:browser": "playwright test --project=edge",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "axe-core": "4.14.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
